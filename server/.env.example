# 复制本文件为 .env 并填写真实值（.env 会被 .gitignore 忽略，不要提交）
# 监听端口
PORT=3000

# Dify 地址：
#   云版：  https://api.dify.ai/v1
#   私有部署：http://你的dify域名/v1（本机 docker 部署通常是 http://localhost:5001/v1 或 http://localhost/v1）
DIFY_API_BASE=http://localhost/v1

# Dify「访问 API」页面的 API Secret（app- 开头）
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxx

# 是否开启简易用户鉴权（true=开启，false=关闭，开发调试时先关掉）
AUTH_ENABLED=false
